PORT=3000

# Gmail / Google Workspace (configuracion verificada como funcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=direccion@novowinds.org
# Contrasena de aplicacion de Google (16 caracteres, sin espacios), no la del correo
SMTP_PASS=

# Opcional: usuario/clave de autenticacion si difieren del remitente
SMTP_AUTH_USER=
SMTP_AUTH_PASS=

CONTACT_FROM=direccion@novowinds.org
CONTACT_TO=direccion@novowinds.org

# En produccion debe ir en false para no caer nunca en la cuenta de prueba
SMTP_ALLOW_TEST_ACCOUNT=false
